    "width_mm": 1500,
    "height_mm": 2000,
    "bleed_mm": 10,
    "dpi": 150,
    "bitdepth": 8,
    "color_profile": "srgb",
    "background": {
      "enabled": true,
      "fill_color": [255, 255, 255]
    },
    "zones": [
      {
        "name": "FaceA",
        "type": "image",
        "x_mm": 0,
        "y_mm": 0,
        "width_mm": 1520,
        "height_mm": 2020,
